{
  "name": "doctrail-backend",
  "version": "2.0.0",
  "description": "DocTrail - track citizen applications across departments: where they are stuck, and why",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "render-build": "prisma generate && prisma db push && npm run prisma:seed && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:samples": "tsx prisma/seed.ts --with-samples",
    "demo": "tsx scripts/demo-flow.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "sla",
    "workflow",
    "tracking",
    "government",
    "doctrail"
  ],
  "author": "DocTrail Team",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
