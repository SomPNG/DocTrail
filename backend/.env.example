PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# REQUIRED in production (the server refuses to start without it)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SLA
SLA_AT_RISK_THRESHOLD_PERCENT=20
SLA_WATCHDOG_ENABLED=true
SLA_WATCHDOG_INTERVAL_MS=60000
STUCK_IDLE_HOURS=48

# Demo & simulation (default: on outside production, off in production)
DEMO_MODE=true
SIMULATION_ENABLED=true

# Notifications: outbound mock channels for citizens (in-app inbox is always used)
NOTIFY_CHANNELS=SMS,WHATSAPP,EMAIL
DOC_REMINDER_HOURS=48

# External systems must send header  x-integration-key: <value>
INTEGRATION_API_KEY=doctrail-dev-integration-key

# Serve /uploads directly (legacy frontend links). Keep false; use signed view tokens.
PUBLIC_UPLOADS=false

# Optional: Gemini for AI features (deterministic fallback is used without it)
GEMINI_API_KEY=
